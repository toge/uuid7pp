@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_uuidv7pp_saved_cmake_module_path "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(simde REQUIRED)
set(CMAKE_MODULE_PATH "${_uuidv7pp_saved_cmake_module_path}")
unset(_uuidv7pp_saved_cmake_module_path)

include("${CMAKE_CURRENT_LIST_DIR}/uuidv7ppTargets.cmake")

check_required_components(uuidv7pp)
